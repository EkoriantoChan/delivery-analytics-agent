# ==============================================================================
# Delivery Analytics Agent - Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your credentials:
#   Windows: Copy-Item .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend & UI Connection
# ------------------------------------------------------------------------------
# API URL for Streamlit UI (use http://localhost:8000 for local, http://api:8000 inside Docker)
AGENT_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Neon Cloud PostgreSQL Database (Read-Only Gold Schema)
# ------------------------------------------------------------------------------
# Format: postgresql://<username>:<password>@<neon-hostname>/<dbname>?sslmode=require
# Paste your Neon connection string provided by the organizers directly here:
GOLD_DATABASE_URL=postgresql://user:password@ep-placeholder.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. LLM Provider Selection
# Set to "openai" or "gemini"
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai

# --- Option A: OpenAI Configuration ---
# Format: sk-proj-... or sk-...
# Paste your OpenAI API Key directly here:
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-luna

# --- Option B: Google Gemini Configuration ---
# Format: AIzaSy...
# If using Gemini, paste your Gemini API Key directly here:
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. Multi-Tenant Demo Authentication Tokens (Pre-configured)
# These tokens are used to test Alice and Bob tenant isolation in the UI.
# ------------------------------------------------------------------------------
DEMO_TOKEN_A=token-alice-demo-secret-123
DEMO_TOKEN_B=token-bob-demo-secret-456

# ------------------------------------------------------------------------------
# 5. SQLite Storage Path
# Inside Docker containers, this maps to the persistent named volume /app/data.
# ------------------------------------------------------------------------------
SQLITE_PATH=/app/data/conversations.sqlite3
